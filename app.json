{
  "expo": {
    "name": "Vocab Phone",
    "slug": "vocab-phone",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "vocabphone",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14141F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.vocab-phone",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["vocabphone"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14141F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withVocabWidget/withVocabWidget.js"
    ],
    "extra": {
      "eas": {
        "projectId": "5243863b-0f29-42d2-9036-b7050e129397"
      }
    }
  }
}
